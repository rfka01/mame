<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Alphacom 32: the thermal paper roll in the dark case, the OFF and ON/ADVANCE keys at the
right below the grille and the Alphacom 32 legend (after photos of a printer).
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.12" green="0.13" blue="0.15" /></rect></element>
	<element name="case_dark"><rect><color red="0.05" green="0.05" blue="0.06" /></rect></element>
	<element name="slot"><rect><color red="0.03" green="0.03" blue="0.04" /></rect></element>
	<element name="label"><rect><color red="0.04" green="0.04" blue="0.05" /></rect></element>
	<element name="key_frame"><rect><color red="0.70" green="0.71" blue="0.73" /></rect></element>
	<element name="key" defstate="0">
		<rect><color red="0.05" green="0.05" blue="0.06" /></rect>
		<rect state="0"><bounds x="0.08" y="0.08" width="0.84" height="0.84" /><color red="0.16" green="0.16" blue="0.18" /></rect>
		<rect state="1"><bounds x="0.08" y="0.08" width="0.84" height="0.84" /><color red="0.09" green="0.09" blue="0.10" /></rect>
	</element>
	<element name="t_name"><text string="Alphacom 32" align="1"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_off"><text string="OFF"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_on"><text string="ON"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_adv"><text string="ADVANCE"><color red="0.85" green="0.86" blue="0.88" /></text></element>

	<view name="Paper and Case">
		<element ref="case"><bounds x="0" y="0" width="960" height="760" /></element>
		<screen tag="bitmap_printer:screen"><bounds x="60" y="20" width="576" height="432" /></screen>
		<element ref="slot"><bounds x="40" y="452" width="616" height="16" /></element>
		<!-- grille -->
		<repeat count="8">
			<param name="y" start="40" increment="34" />
			<element ref="case_dark"><bounds x="690" y="~y~" width="240" height="14" /></element>
		</repeat>
		<!-- keys -->
		<element ref="key_frame"><bounds x="696" y="330" width="100" height="70" /></element>
		<element id="off" ref="key" inputtag="BUTTONS" inputmask="0x02"><bounds x="702" y="336" width="88" height="58" /></element>
		<element ref="t_off"><bounds x="712" y="352" width="68" height="26" /></element>
		<element ref="key_frame"><bounds x="826" y="330" width="100" height="70" /></element>
		<element id="feed" ref="key" inputtag="BUTTONS" inputmask="0x01"><bounds x="832" y="336" width="88" height="58" /></element>
		<element ref="t_on"><bounds x="842" y="340" width="68" height="22" /></element>
		<element ref="t_adv"><bounds x="838" y="366" width="76" height="20" /></element>
		<repeat count="3">
			<param name="y" start="440" increment="30" />
			<element ref="case_dark"><bounds x="690" y="~y~" width="240" height="12" /></element>
		</repeat>
		<element ref="label"><bounds x="120" y="640" width="440" height="60" /></element>
		<element ref="t_name"><bounds x="140" y="645" width="400" height="50" /></element>
	</view>

	<view name="Paper">
		<screen tag="bitmap_printer:screen"><bounds x="0" y="0" width="576" height="432" /></screen>
	</view>
</mamelayout>
