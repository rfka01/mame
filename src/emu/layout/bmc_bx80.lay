<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
BMC BX-80 / Microbee Admate DP-80: paper and control panel, after a photo of the printer
(cream case with a smoked brown dust cover; upright dark panel at the right front with the
POWER, READY and PAPER OUT lamps on top, the ON LINE lamp and below it the cream ON LINE,
FF and LF keys, legends at the left of the lamps and keys)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.89" green="0.86" blue="0.75" /></rect></element>
	<element name="case_shade"><rect><color red="0.78" green="0.75" blue="0.64" /></rect></element>
	<element name="cover"><rect><color red="0.27" green="0.19" blue="0.16" /></rect></element>
	<element name="panel_frame"><rect><color red="0.48" green="0.45" blue="0.40" /></rect></element>
	<element name="panel"><rect><color red="0.17" green="0.14" blue="0.13" /></rect></element>
	<element name="badge">
		<rect><color red="0.08" green="0.08" blue="0.08" /></rect>
		<text string="BMC"><bounds x="0.25" y="0.12" width="0.65" height="0.76" /><color red="0.85" green="0.85" blue="0.85" /></text>
		<disk><bounds x="0.07" y="0.25" width="0.13" height="0.50" /><color red="0.70" green="0.70" blue="0.70" /></disk>
	</element>

	<element name="key" defstate="0">
		<rect><color red="0.45" green="0.43" blue="0.40" /></rect>
		<rect state="0"><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="0.93" green="0.92" blue="0.86" /></rect>
		<rect state="1"><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="0.76" green="0.75" blue="0.70" /></rect>
	</element>
	<element name="lamp_green" defstate="0">
		<disk><color red="0.10" green="0.10" blue="0.10" /></disk>
		<disk state="0"><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="0.16" green="0.26" blue="0.16" /></disk>
		<disk state="1"><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="0.35" green="1.00" blue="0.35" /></disk>
	</element>
	<element name="lamp_red" defstate="0">
		<disk><color red="0.10" green="0.10" blue="0.10" /></disk>
		<disk state="0"><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="0.30" green="0.14" blue="0.14" /></disk>
		<disk state="1"><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="1.00" green="0.15" blue="0.10" /></disk>
	</element>

	<element name="t_power"><text string="POWER" align="2"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="t_ready"><text string="READY" align="2"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="t_paper"><text string="PAPER OUT" align="2"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="t_online"><text string="ON LINE" align="2"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="t_ff"><text string="FF" align="2"><color red="0.90" green="0.90" blue="0.88" /></text></element>
	<element name="t_lf"><text string="LF" align="2"><color red="0.90" green="0.90" blue="0.88" /></text></element>

	<group name="controls">
		<element ref="panel_frame"><bounds x="0" y="0" width="200" height="420" /></element>
		<element ref="panel"><bounds x="8" y="8" width="184" height="404" /></element>

		<element ref="t_power"><bounds x="20" y="26" width="120" height="20" /></element>
		<element name="bx80_led0" ref="lamp_green"><bounds x="152" y="27" width="18" height="18" /></element>
		<element ref="t_ready"><bounds x="20" y="56" width="120" height="20" /></element>
		<element name="bx80_led2" ref="lamp_green"><bounds x="152" y="57" width="18" height="18" /></element>
		<element ref="t_paper"><bounds x="20" y="86" width="120" height="20" /></element>
		<element name="bx80_led3" ref="lamp_red"><bounds x="152" y="87" width="18" height="18" /></element>

		<element ref="t_online"><bounds x="20" y="138" width="120" height="20" /></element>
		<element name="bx80_led1" ref="lamp_green"><bounds x="152" y="139" width="18" height="18" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x02"><bounds x="112" y="172" width="64" height="56" /></element>

		<element ref="t_ff"><bounds x="20" y="260" width="80" height="20" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x08"><bounds x="112" y="242" width="64" height="56" /></element>

		<element ref="t_lf"><bounds x="20" y="330" width="80" height="20" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x04"><bounds x="112" y="312" width="64" height="56" /></element>
	</group>

	<view name="Paper and Control Panel">
		<element ref="case"><bounds x="0" y="0" width="1460" height="520" /></element>
		<screen tag="bitmap_printer:screen">
			<bounds x="20" y="0" width="1140" height="360" />
		</screen>
		<element ref="cover"><bounds x="20" y="360" width="1140" height="60" /></element>
		<element ref="case_shade"><bounds x="0" y="420" width="1460" height="6" /></element>
		<element ref="badge"><bounds x="60" y="450" width="120" height="34" /></element>
		<group ref="controls"><bounds x="1210" y="40" width="200" height="420" /></group>
	</view>

	<view name="Control panel">
		<element ref="case"><bounds x="0" y="0" width="240" height="460" /></element>
		<group ref="controls"><bounds x="20" y="20" width="200" height="420" /></group>
	</view>
</mamelayout>
