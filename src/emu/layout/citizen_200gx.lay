<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Citizen 200GX: paper and Command-Vue II control panel, after a photo of the panel
(cream case; dark grey key field with ON LINE, PARK/LOAD, LF/FF and QUIET keys, each with
a coloured stripe and a lamp at its right; light grey menu field with the MENU switch, its
positions INSTALL, FONT, PITCH and ON LINE, and the PAPER OUT and POWER lamps)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.90" green="0.87" blue="0.78" /></rect></element>
	<element name="case_dark"><rect><color red="0.80" green="0.77" blue="0.68" /></rect></element>
	<element name="panel_rim"><rect><color red="0.84" green="0.82" blue="0.76" /></rect></element>
	<element name="key_field"><rect><color red="0.33" green="0.34" blue="0.38" /></rect></element>
	<element name="menu_field"><rect><color red="0.63" green="0.65" blue="0.68" /></rect></element>
	<element name="knob">
		<rect><color red="0.88" green="0.86" blue="0.80" /></rect>
		<rect><bounds x="0.00" y="0.10" width="1.0" height="0.04" /><color red="0.75" green="0.73" blue="0.67" /></rect>
		<rect><bounds x="0.00" y="0.30" width="1.0" height="0.04" /><color red="0.75" green="0.73" blue="0.67" /></rect>
		<rect><bounds x="0.00" y="0.50" width="1.0" height="0.04" /><color red="0.75" green="0.73" blue="0.67" /></rect>
		<rect><bounds x="0.00" y="0.70" width="1.0" height="0.04" /><color red="0.75" green="0.73" blue="0.67" /></rect>
		<rect><bounds x="0.00" y="0.90" width="1.0" height="0.04" /><color red="0.75" green="0.73" blue="0.67" /></rect>
	</element>

	<element name="key" defstate="0">
		<rect state="0"><color red="0.40" green="0.41" blue="0.45" /></rect>
		<rect state="1"><color red="0.28" green="0.29" blue="0.32" /></rect>
	</element>
	<element name="lamp" defstate="0">
		<rect><color red="0.08" green="0.08" blue="0.08" /></rect>
		<rect state="0"><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="0.20" green="0.10" blue="0.08" /></rect>
		<rect state="1"><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="1.00" green="0.25" blue="0.15" /></rect>
	</element>
	<element name="lamp_green" defstate="0">
		<rect><color red="0.08" green="0.08" blue="0.08" /></rect>
		<rect state="0"><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="0.10" green="0.18" blue="0.10" /></rect>
		<rect state="1"><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="0.35" green="0.95" blue="0.30" /></rect>
	</element>
	<element name="power_lamp">
		<rect><color red="0.08" green="0.08" blue="0.08" /></rect>
		<rect><bounds x="0.15" y="0.15" width="0.70" height="0.70" /><color red="0.35" green="0.95" blue="0.30" /></rect>
	</element>
	<element name="stripe_red"><rect><color red="0.85" green="0.12" blue="0.12" /></rect></element>
	<element name="stripe_yellow"><rect><color red="0.95" green="0.80" blue="0.10" /></rect></element>
	<element name="stripe_blue"><rect><color red="0.30" green="0.60" blue="0.90" /></rect></element>
	<element name="stripe_grey"><rect><color red="0.55" green="0.56" blue="0.60" /></rect></element>

	<!-- menu switch: the lever sits beside one of the four positions -->
	<element name="menu_switch" defstate="0">
		<rect><color red="0.22" green="0.23" blue="0.26" /></rect>
		<rect><bounds x="0.42" y="0.04" width="0.16" height="0.92" /><color red="0.12" green="0.12" blue="0.14" /></rect>
		<rect state="2"><bounds x="0.10" y="0.02" width="0.80" height="0.22" /><color red="0.50" green="0.51" blue="0.55" /></rect>
		<rect state="3"><bounds x="0.10" y="0.26" width="0.80" height="0.22" /><color red="0.50" green="0.51" blue="0.55" /></rect>
		<rect state="1"><bounds x="0.10" y="0.52" width="0.80" height="0.22" /><color red="0.50" green="0.51" blue="0.55" /></rect>
		<rect state="0"><bounds x="0.10" y="0.76" width="0.80" height="0.22" /><color red="0.50" green="0.51" blue="0.55" /></rect>
	</element>
	<element name="tick"><rect><color red="0.30" green="0.31" blue="0.34" /></rect></element>

	<element name="t_title"><text string="COMMAND-VUE II" align="0"><color red="0.15" green="0.16" blue="0.20" /></text></element>
	<element name="t_online"><text string="ON LINE" align="0"><color red="0.90" green="0.90" blue="0.90" /></text></element>
	<element name="t_park"><text string="PARK/LOAD &#x25b2;" align="0"><color red="0.90" green="0.90" blue="0.90" /></text></element>
	<element name="t_lfff"><text string="LF/FF &#x25bc;" align="0"><color red="0.90" green="0.90" blue="0.90" /></text></element>
	<element name="t_quiet"><text string="QUIET" align="0"><color red="0.90" green="0.90" blue="0.90" /></text></element>
	<element name="t_menu"><text string="MENU" align="0"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="t_install"><text string="INSTALL" align="1"><color red="0.10" green="0.11" blue="0.14" /></text></element>
	<element name="t_font"><text string="FONT" align="1"><color red="0.10" green="0.11" blue="0.14" /></text></element>
	<element name="t_pitch"><text string="PITCH" align="1"><color red="0.10" green="0.11" blue="0.14" /></text></element>
	<element name="t_monline"><text string="ON LINE" align="1"><color red="0.10" green="0.11" blue="0.14" /></text></element>
	<element name="t_paper"><text string="PAPER OUT" align="1"><color red="0.10" green="0.11" blue="0.14" /></text></element>
	<element name="t_power"><text string="POWER" align="1"><color red="0.10" green="0.11" blue="0.14" /></text></element>

	<group name="controls">
		<element ref="panel_rim"><bounds x="0" y="0" width="320" height="700" /></element>
		<element ref="t_title"><bounds x="20" y="10" width="280" height="30" /></element>

		<element ref="key_field"><bounds x="16" y="46" width="288" height="352" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x20"><bounds x="30" y="60" width="150" height="56" /></element>
		<element ref="t_online"><bounds x="36" y="74" width="138" height="28" /></element>
		<element ref="stripe_red"><bounds x="196" y="58" width="14" height="60" /></element>
		<element name="c200gx_key_led0" ref="lamp_green"><bounds x="248" y="76" width="24" height="24" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x40"><bounds x="30" y="146" width="150" height="56" /></element>
		<element ref="t_park"><bounds x="36" y="160" width="138" height="28" /></element>
		<element ref="stripe_yellow"><bounds x="196" y="144" width="14" height="60" /></element>
		<element name="c200gx_key_led1" ref="lamp_green"><bounds x="248" y="162" width="24" height="24" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x80"><bounds x="30" y="232" width="150" height="56" /></element>
		<element ref="t_lfff"><bounds x="36" y="246" width="138" height="28" /></element>
		<element ref="stripe_blue"><bounds x="196" y="230" width="14" height="60" /></element>
		<element name="c200gx_key_led2" ref="lamp_green"><bounds x="248" y="248" width="24" height="24" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x10"><bounds x="30" y="318" width="150" height="56" /></element>
		<element ref="t_quiet"><bounds x="36" y="332" width="138" height="28" /></element>
		<element ref="stripe_grey"><bounds x="196" y="316" width="14" height="60" /></element>
		<element name="c200gx_key_led3" ref="lamp_green"><bounds x="248" y="334" width="24" height="24" /></element>

		<element ref="menu_field"><bounds x="16" y="412" width="288" height="274" /></element>
		<element ref="menu_switch" inputtag="CONFIG" inputmask="0x03" inputraw="yes"><bounds x="44" y="428" width="90" height="150" /></element>
		<element ref="t_menu"><bounds x="44" y="584" width="90" height="26" /></element>
		<element ref="tick"><bounds x="148" y="440" width="14" height="14" /></element>
		<element ref="t_install"><bounds x="170" y="434" width="130" height="26" /></element>
		<element ref="tick"><bounds x="148" y="476" width="14" height="14" /></element>
		<element ref="t_font"><bounds x="170" y="470" width="130" height="26" /></element>
		<element ref="tick"><bounds x="148" y="512" width="14" height="14" /></element>
		<element ref="t_pitch"><bounds x="170" y="506" width="130" height="26" /></element>
		<element ref="tick"><bounds x="148" y="548" width="14" height="14" /></element>
		<element ref="t_monline"><bounds x="170" y="542" width="130" height="26" /></element>
		<element name="c200gx_paper_led" ref="lamp"><bounds x="148" y="596" width="16" height="16" /></element>
		<element ref="t_paper"><bounds x="170" y="590" width="130" height="26" /></element>
		<element ref="power_lamp"><bounds x="148" y="632" width="16" height="16" /></element>
		<element ref="t_power"><bounds x="170" y="626" width="130" height="26" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="360" />
		</screen>
		<element ref="case"><bounds x="0" y="360" width="1140" height="380" /></element>
		<element ref="case_dark"><bounds x="0" y="360" width="1140" height="6" /></element>
		<element ref="case"><bounds x="1140" y="0" width="420" height="740" /></element>
		<group ref="controls"><bounds x="1160" y="20" width="320" height="700" /></group>
		<element ref="knob"><bounds x="1500" y="120" width="44" height="170" /></element>
	</view>

	<view name="Control panel">
		<element ref="case"><bounds x="0" y="0" width="360" height="740" /></element>
		<group ref="controls"><bounds x="20" y="20" width="320" height="700" /></group>
	</view>
</mamelayout>
