<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Epson ActionPrinter 3250 (LQ-100): paper and control panel, after a photo of the panel
(light beige panel; orange-red font legend with the two font lamps, the FONT/YES and
FF/NO keys either side of the PAPER PARK legend, the READY lamp at the right)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.86" green="0.84" blue="0.76" /></rect></element>
	<element name="case_dark"><rect><color red="0.74" green="0.72" blue="0.64" /></rect></element>
	<element name="panel">
		<rect><color red="0.62" green="0.61" blue="0.57" /></rect>
		<rect><bounds x="0.003" y="0.01" width="0.994" height="0.98" /><color red="0.90" green="0.89" blue="0.84" /></rect>
	</element>
	<element name="legend"><rect><color red="0.96" green="0.42" blue="0.36" /></rect></element>
	<element name="bar"><rect><color red="0.62" green="0.64" blue="0.68" /></rect></element>
	<element name="bar_red"><rect><color red="0.96" green="0.42" blue="0.36" /></rect></element>

	<element name="key" defstate="0">
		<rect><color red="0.55" green="0.54" blue="0.50" /></rect>
		<rect state="0"><bounds x="0.08" y="0.03" width="0.84" height="0.94" /><color red="0.96" green="0.95" blue="0.90" /></rect>
		<rect state="1"><bounds x="0.08" y="0.03" width="0.84" height="0.94" /><color red="0.80" green="0.79" blue="0.74" /></rect>
	</element>
	<element name="lamp" defstate="0">
		<disk><color red="0.18" green="0.16" blue="0.15" /></disk>
		<disk state="1"><bounds x="0.15" y="0.15" width="0.7" height="0.7" /><color red="0.45" green="1.00" blue="0.30" /></disk>
	</element>

	<element name="t_epson"><text string="EPSON" align="1"><color red="0.10" green="0.10" blue="0.12" /></text></element>
	<element name="t_model"><text string="ActionPrinter 3250" align="1"><color red="0.75" green="0.15" blue="0.12" /></text></element>
	<element name="t_escp2"><text string="ESC/P 2" align="1"><color red="0.15" green="0.35" blue="0.75" /></text></element>
	<element name="t_roman"><text string="&#x25cf;&#x25cf; Roman" align="1"><color red="0.45" green="0.10" blue="0.08" /></text></element>
	<element name="t_sans"><text string="&#x25cf;&#x25cb; Sans Serif" align="1"><color red="0.45" green="0.10" blue="0.08" /></text></element>
	<element name="t_courier"><text string="&#x25cb;&#x25cf; Courier" align="1"><color red="0.45" green="0.10" blue="0.08" /></text></element>
	<element name="t_prestige"><text string="** Prestige" align="1"><color red="0.45" green="0.10" blue="0.08" /></text></element>
	<element name="t_script"><text string="*&#x25cb; Script" align="1"><color red="0.45" green="0.10" blue="0.08" /></text></element>
	<element name="t_draft"><text string="&#x25cb;* Draft" align="1"><color red="0.45" green="0.10" blue="0.08" /></text></element>
	<element name="t_draftc"><text string="&#x25cb;&#x25cb; Draft Condensed" align="1"><color red="0.45" green="0.10" blue="0.08" /></text></element>
	<element name="t_font"><text string="FONT"><color red="0.10" green="0.10" blue="0.12" /></text></element>
	<element name="t_ff"><text string="FF"><color red="0.10" green="0.10" blue="0.12" /></text></element>
	<element name="t_yes"><text string="YES"><color red="0.10" green="0.10" blue="0.12" /></text></element>
	<element name="t_no"><text string="NO"><color red="0.10" green="0.10" blue="0.12" /></text></element>
	<element name="t_paper"><text string="PAPER"><color red="0.10" green="0.10" blue="0.12" /></text></element>
	<element name="t_park"><text string="PARK"><color red="0.10" green="0.10" blue="0.12" /></text></element>
	<element name="t_ready"><text string="READY"><color red="0.10" green="0.10" blue="0.12" /></text></element>

	<group name="controls">
		<element ref="panel"><bounds x="0" y="0" width="1100" height="250" /></element>
		<element ref="t_epson"><bounds x="30" y="18" width="160" height="44" /></element>
		<element ref="t_model"><bounds x="190" y="26" width="300" height="34" /></element>
		<element ref="t_escp2"><bounds x="30" y="150" width="140" height="34" /></element>

		<!-- font legend and lamps -->
		<element ref="legend"><bounds x="180" y="80" width="420" height="140" /></element>
		<element ref="bar_red"><bounds x="600" y="88" width="120" height="8" /></element>
		<element ref="t_roman"><bounds x="190" y="90" width="200" height="28" /></element>
		<element ref="t_sans"><bounds x="190" y="120" width="200" height="28" /></element>
		<element ref="t_courier"><bounds x="190" y="150" width="200" height="28" /></element>
		<element ref="t_prestige"><bounds x="190" y="180" width="200" height="28" /></element>
		<element ref="t_script"><bounds x="400" y="120" width="200" height="28" /></element>
		<element ref="t_draft"><bounds x="400" y="150" width="200" height="28" /></element>
		<element ref="t_draftc"><bounds x="400" y="180" width="200" height="28" /></element>
		<element name="ap3250_led0" ref="lamp"><bounds x="480" y="88" width="18" height="18" /></element>
		<element name="ap3250_led1" ref="lamp"><bounds x="535" y="88" width="18" height="18" /></element>

		<!-- keys -->
		<element ref="bar"><bounds x="615" y="190" width="300" height="10" /></element>
		<element ref="t_font"><bounds x="610" y="60" width="90" height="26" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x10"><bounds x="630" y="90" width="50" height="135" /></element>
		<element ref="t_yes"><bounds x="610" y="226" width="90" height="20" /></element>
		<element ref="t_paper"><bounds x="700" y="130" width="120" height="26" /></element>
		<element ref="t_park"><bounds x="700" y="156" width="120" height="26" /></element>
		<element ref="t_ff"><bounds x="820" y="60" width="90" height="26" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x20"><bounds x="840" y="90" width="50" height="135" /></element>
		<element ref="t_no"><bounds x="820" y="226" width="90" height="20" /></element>

		<!-- READY -->
		<element name="ap3250_led2" ref="lamp"><bounds x="975" y="100" width="18" height="18" /></element>
		<element ref="t_ready"><bounds x="930" y="170" width="110" height="28" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="360" />
		</screen>
		<element ref="case"><bounds x="0" y="360" width="1140" height="290" /></element>
		<element ref="case_dark"><bounds x="0" y="360" width="1140" height="6" /></element>
		<group ref="controls"><bounds x="20" y="380" width="1100" height="250" /></group>
	</view>

	<view name="Control panel">
		<element ref="case"><bounds x="0" y="0" width="1140" height="290" /></element>
		<group ref="controls"><bounds x="20" y="20" width="1100" height="250" /></group>
	</view>
</mamelayout>
