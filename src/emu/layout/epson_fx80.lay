-->
<mamelayout version="2">
	<element name="panel"><rect><color red="0.82" green="0.80" blue="0.74" /></rect></element>
	<element name="led_green" defstate="0">
		<disk state="0"><color red="0.10" green="0.25" blue="0.10" /></disk>
		<disk state="1"><color red="0.20" green="1.00" blue="0.20" /></disk>
	</element>
	<element name="led_red" defstate="0">
		<disk state="0"><color red="0.25" green="0.08" blue="0.08" /></disk>
		<disk state="1"><color red="1.00" green="0.20" blue="0.20" /></disk>
	</element>
	<element name="key" defstate="0">
		<rect state="0"><color red="0.30" green="0.30" blue="0.32" /></rect>
		<rect state="1"><color red="0.55" green="0.55" blue="0.58" /></rect>
	</element>
	<element name="t_power"><text string="POWER"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_ready"><text string="READY"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_paper"><text string="PAPER OUT"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_online"><text string="ON LINE"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_ff"><text string="FORM FEED"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_lf"><text string="LINE FEED"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="power_on"><disk><color red="0.20" green="1.00" blue="0.20" /></disk></element>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="213" />
		</screen>
		<element ref="panel"><bounds x="0" y="213" width="1140" height="90" /></element>

		<element ref="power_on"><bounds x="40" y="229" width="14" height="14" /></element>
		<element ref="t_power"><bounds x="20" y="249" width="55" height="18" /></element>
		<element name="fx80_ready_led" ref="led_green"><bounds x="120" y="229" width="14" height="14" /></element>
		<element ref="t_ready"><bounds x="100" y="249" width="55" height="18" /></element>
		<element name="fx80_paper_led" ref="led_red"><bounds x="210" y="229" width="14" height="14" /></element>
		<element ref="t_paper"><bounds x="180" y="249" width="75" height="18" /></element>
		<element name="fx80_online_led" ref="led_green"><bounds x="300" y="229" width="14" height="14" /></element>
		<element ref="t_online"><bounds x="275" y="249" width="65" height="18" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x01"><bounds x="440" y="235" width="60" height="30" /></element>
		<element ref="t_online"><bounds x="435" y="270" width="70" height="16" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x02"><bounds x="550" y="235" width="60" height="30" /></element>
		<element ref="t_ff"><bounds x="535" y="270" width="90" height="16" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x04"><bounds x="660" y="235" width="60" height="30" /></element>
		<element ref="t_lf"><bounds x="645" y="270" width="90" height="16" /></element>
	</view>
</mamelayout>
