<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Epson FX-85: paper and control panel, after photos of the printer
(dark grey panel at the right front: POWER, READY and PAPER OUT in grey boxes with their
 lamps at the right, three square cream keys, the ON LINE lamp right of the top key, the
 key functions below each key in a grey box (off line) and a blue box (on line))
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.90" green="0.89" blue="0.82" /></rect></element>
	<element name="case_dark"><rect><color red="0.80" green="0.79" blue="0.72" /></rect></element>
	<element name="panel"><rect><color red="0.24" green="0.25" blue="0.27" /></rect></element>
	<element name="box_grey"><rect><color red="0.45" green="0.46" blue="0.48" /></rect></element>
	<element name="box_blue"><rect><color red="0.16" green="0.45" blue="0.85" /></rect></element>

	<element name="led_power"><rect><color red="0.35" green="1.00" blue="0.45" /></rect></element>
	<element name="led_green" defstate="0">
		<rect state="0"><color red="0.14" green="0.30" blue="0.20" /></rect>
		<rect state="1"><color red="0.35" green="1.00" blue="0.45" /></rect>
	</element>
	<element name="led_red" defstate="0">
		<rect state="0"><color red="0.35" green="0.14" blue="0.14" /></rect>
		<rect state="1"><color red="1.00" green="0.22" blue="0.18" /></rect>
	</element>
	<element name="key" defstate="0">
		<rect state="0"><color red="0.94" green="0.90" blue="0.74" /></rect>
		<rect state="1"><color red="0.76" green="0.72" blue="0.58" /></rect>
	</element>

	<element name="t_power"><text string="POWER"><color red="0.92" green="0.93" blue="0.95" /></text></element>
	<element name="t_ready"><text string="READY"><color red="0.92" green="0.93" blue="0.95" /></text></element>
	<element name="t_paper"><text string="PAPER"><color red="0.92" green="0.93" blue="0.95" /></text></element>
	<element name="t_out"><text string="OUT"><color red="0.92" green="0.93" blue="0.95" /></text></element>
	<element name="t_off"><text string="OFF"><color red="0.92" green="0.93" blue="0.95" /></text></element>
	<element name="t_on"><text string="ON"><color red="0.97" green="0.98" blue="1.00" /></text></element>
	<element name="t_line"><text string="LINE"><color red="0.92" green="0.93" blue="0.95" /></text></element>
	<element name="t_line_b"><text string="LINE"><color red="0.97" green="0.98" blue="1.00" /></text></element>
	<element name="t_ff"><text string="FF"><color red="0.92" green="0.93" blue="0.95" /></text></element>
	<element name="t_nlq"><text string="NLQ"><color red="0.97" green="0.98" blue="1.00" /></text></element>
	<element name="t_lf"><text string="LF"><color red="0.92" green="0.93" blue="0.95" /></text></element>
	<element name="t_draft"><text string="DRAFT"><color red="0.97" green="0.98" blue="1.00" /></text></element>

	<group name="controls">
		<element ref="panel"><bounds x="0" y="0" width="200" height="600" /></element>

		<element ref="box_grey"><bounds x="12" y="20" width="176" height="40" /></element>
		<element ref="t_power"><bounds x="20" y="28" width="110" height="24" /></element>
		<element ref="led_power"><bounds x="160" y="30" width="12" height="20" /></element>
		<element ref="box_grey"><bounds x="12" y="70" width="176" height="40" /></element>
		<element ref="t_ready"><bounds x="20" y="78" width="110" height="24" /></element>
		<element name="fx80_ready_led" ref="led_green"><bounds x="160" y="80" width="12" height="20" /></element>
		<element ref="box_grey"><bounds x="12" y="120" width="176" height="48" /></element>
		<element ref="t_paper"><bounds x="20" y="122" width="110" height="22" /></element>
		<element ref="t_out"><bounds x="20" y="144" width="110" height="22" /></element>
		<element name="fx80_paper_led" ref="led_red"><bounds x="160" y="134" width="12" height="20" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x01"><bounds x="56" y="198" width="76" height="72" /></element>
		<element name="fx80_online_led" ref="led_green"><bounds x="150" y="222" width="12" height="20" /></element>
		<element ref="box_grey"><bounds x="12" y="282" width="84" height="40" /></element>
		<element ref="t_off"><bounds x="12" y="282" width="84" height="20" /></element>
		<element ref="t_line"><bounds x="12" y="302" width="84" height="20" /></element>
		<element ref="box_blue"><bounds x="100" y="282" width="88" height="40" /></element>
		<element ref="t_on"><bounds x="100" y="282" width="88" height="20" /></element>
		<element ref="t_line_b"><bounds x="100" y="302" width="88" height="20" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x02"><bounds x="56" y="336" width="76" height="72" /></element>
		<element ref="box_grey"><bounds x="12" y="420" width="84" height="34" /></element>
		<element ref="t_ff"><bounds x="12" y="425" width="84" height="24" /></element>
		<element ref="box_blue"><bounds x="100" y="420" width="88" height="34" /></element>
		<element ref="t_nlq"><bounds x="100" y="425" width="88" height="24" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x04"><bounds x="56" y="468" width="76" height="72" /></element>
		<element ref="box_grey"><bounds x="12" y="552" width="84" height="34" /></element>
		<element ref="t_lf"><bounds x="12" y="557" width="84" height="24" /></element>
		<element ref="box_blue"><bounds x="100" y="552" width="88" height="34" /></element>
		<element ref="t_draft"><bounds x="100" y="557" width="88" height="24" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="360" />
		</screen>
		<element ref="case"><bounds x="0" y="360" width="1140" height="260" /></element>
		<element ref="case_dark"><bounds x="0" y="360" width="1140" height="6" /></element>
		<element ref="case"><bounds x="1140" y="0" width="280" height="620" /></element>
		<group ref="controls"><bounds x="1180" y="10" width="200" height="600" /></group>
	</view>

	<view name="Control panel">
		<element ref="case"><bounds x="0" y="0" width="280" height="640" /></element>
		<group ref="controls"><bounds x="40" y="20" width="200" height="600" /></group>
	</view>
</mamelayout>
