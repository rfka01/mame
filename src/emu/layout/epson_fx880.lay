<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Epson FX-880: paper and control panel, after a photo of the panel
(light grey panel; blue-grey key fields Tear Off/Bin, LF/FF, Load/Eject and Pause with
cream keys; the two Font lamps with their legend at the left, the Paper Out lamp and
the Operate switch at the right)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.86" green="0.85" blue="0.80" /></rect></element>
	<element name="case_dark"><rect><color red="0.74" green="0.73" blue="0.68" /></rect></element>
	<element name="panel"><rect><color red="0.84" green="0.86" blue="0.88" /></rect></element>
	<element name="field"><rect><color red="0.66" green="0.72" blue="0.82" /></rect></element>
	<element name="strip"><rect><color red="0.70" green="0.72" blue="0.75" /></rect></element>

	<element name="key" defstate="0">
		<rect><color red="0.35" green="0.35" blue="0.35" /></rect>
		<rect state="0"><bounds x="0.03" y="0.06" width="0.94" height="0.88" /><color red="0.95" green="0.93" blue="0.88" /></rect>
		<rect state="1"><bounds x="0.03" y="0.06" width="0.94" height="0.88" /><color red="0.80" green="0.78" blue="0.73" /></rect>
	</element>
	<element name="operate">
		<rect><color red="0.55" green="0.55" blue="0.52" /></rect>
		<rect><bounds x="0.06" y="0.06" width="0.88" height="0.88" /><color red="0.93" green="0.92" blue="0.88" /></rect>
		<text string="&#x23fb;"><bounds x="0.06" y="0.10" width="0.88" height="0.80" /><color red="0.30" green="0.30" blue="0.30" /></text>
	</element>

	<element name="lamp_green" defstate="0">
		<rect state="0"><color red="0.30" green="0.34" blue="0.30" /></rect>
		<rect state="1"><color red="0.75" green="1.00" blue="0.20" /></rect>
	</element>
	<element name="lamp_orange" defstate="0">
		<rect state="0"><color red="0.36" green="0.33" blue="0.30" /></rect>
		<rect state="1"><color red="1.00" green="0.60" blue="0.10" /></rect>
	</element>
	<element name="lamp_red" defstate="0">
		<rect state="0"><color red="0.36" green="0.30" blue="0.30" /></rect>
		<rect state="1"><color red="1.00" green="0.15" blue="0.10" /></rect>
	</element>

	<element name="t_font"><text string="Font" align="0"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_draft"><text string="Draft" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_draftc"><text string="Draft Condensed" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_roman"><text string="Roman" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_romanc"><text string="Roman Condensed" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_sans"><text string="Sans Serif" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_sansc"><text string="Sans Serif Condensed" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_tear"><text string="Tear Off/Bin" align="0"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_tearoff"><text string="Tear Off" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_bin1"><text string="Bin 1" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_bin2"><text string="Bin 2" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_lfff"><text string="LF / FF" align="0"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_load"><text string="Load / Eject" align="0"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_pause"><text string="Pause" align="0"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_3sec"><text string="3 sec" align="1"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_micro"><text string="&#x25bc; Micro Adjust &#x25b2;" align="0"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_paper"><text string="Paper Out" align="0"><color red="0.15" green="0.15" blue="0.20" /></text></element>
	<element name="t_operate"><text string="Operate" align="0"><color red="0.15" green="0.15" blue="0.20" /></text></element>

	<group name="controls">
		<element ref="panel"><bounds x="0" y="0" width="1100" height="230" /></element>

		<!-- Font -->
		<element ref="t_font"><bounds x="20" y="10" width="110" height="26" /></element>
		<element name="fx880_led3" ref="lamp_green"><bounds x="48" y="42" width="14" height="12" /></element>
		<element name="fx880_led4" ref="lamp_green"><bounds x="86" y="42" width="14" height="12" /></element>
		<element ref="t_draft"><bounds x="40" y="64" width="170" height="20" /></element>
		<element ref="t_draftc"><bounds x="40" y="86" width="170" height="16" /></element>
		<element ref="t_roman"><bounds x="40" y="106" width="170" height="20" /></element>
		<element ref="t_romanc"><bounds x="40" y="128" width="170" height="16" /></element>
		<element ref="t_sans"><bounds x="40" y="148" width="170" height="20" /></element>
		<element ref="t_sansc"><bounds x="40" y="170" width="170" height="16" /></element>

		<!-- Tear Off/Bin -->
		<element ref="field"><bounds x="220" y="10" width="180" height="150" /></element>
		<element ref="t_tear"><bounds x="226" y="16" width="168" height="26" /></element>
		<element name="fx880_led2" ref="lamp_green"><bounds x="240" y="50" width="14" height="12" /></element>
		<element ref="t_tearoff"><bounds x="250" y="70" width="140" height="20" /></element>
		<element ref="t_bin1"><bounds x="250" y="92" width="140" height="20" /></element>
		<element ref="t_bin2"><bounds x="250" y="114" width="140" height="20" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x08"><bounds x="250" y="150" width="90" height="40" /></element>

		<!-- LF/FF -->
		<element ref="field"><bounds x="410" y="10" width="150" height="150" /></element>
		<element ref="t_lfff"><bounds x="416" y="16" width="138" height="26" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x04"><bounds x="440" y="150" width="90" height="40" /></element>

		<!-- Load/Eject -->
		<element ref="field"><bounds x="570" y="10" width="150" height="150" /></element>
		<element ref="t_load"><bounds x="576" y="16" width="138" height="26" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x02"><bounds x="600" y="150" width="90" height="40" /></element>

		<element ref="strip"><bounds x="410" y="196" width="490" height="30" /></element>
		<element ref="t_micro"><bounds x="460" y="198" width="220" height="26" /></element>

		<!-- Pause -->
		<element ref="field"><bounds x="730" y="10" width="170" height="150" /></element>
		<element ref="t_pause"><bounds x="736" y="16" width="158" height="26" /></element>
		<element name="fx880_led0" ref="lamp_orange"><bounds x="808" y="50" width="14" height="12" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x01"><bounds x="770" y="150" width="90" height="40" /></element>
		<element ref="t_3sec"><bounds x="790" y="198" width="80" height="26" /></element>

		<!-- Paper Out and Operate -->
		<element ref="t_paper"><bounds x="920" y="16" width="160" height="26" /></element>
		<element name="fx880_led1" ref="lamp_red"><bounds x="930" y="50" width="14" height="12" /></element>
		<element ref="t_operate"><bounds x="930" y="74" width="140" height="26" /></element>
		<element ref="operate"><bounds x="950" y="110" width="100" height="80" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="360" />
		</screen>
		<element ref="case"><bounds x="0" y="360" width="1140" height="270" /></element>
		<element ref="case_dark"><bounds x="0" y="360" width="1140" height="6" /></element>
		<group ref="controls"><bounds x="20" y="380" width="1100" height="230" /></group>
	</view>

	<view name="Control panel">
		<element ref="case"><bounds x="0" y="0" width="1140" height="270" /></element>
		<group ref="controls"><bounds x="20" y="20" width="1100" height="230" /></group>
	</view>
</mamelayout>
