<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Epson JX-80: paper and control panel, after photos of the printer
(dark panel at the right front: POWER, READY, PAPER OUT lamps right of their labels,
 ON LINE key with its lamp at its upper right, FF and LF keys, labels below the keys)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.90" green="0.82" blue="0.58" /></rect></element>
	<element name="case_dark"><rect><color red="0.80" green="0.72" blue="0.50" /></rect></element>
	<element name="panel"><rect><color red="0.19" green="0.20" blue="0.24" /></rect></element>

	<element name="led_power"><rect><color red="0.35" green="1.00" blue="0.35" /></rect></element>
	<element name="led_green" defstate="0">
		<rect state="0"><color red="0.14" green="0.26" blue="0.17" /></rect>
		<rect state="1"><color red="0.35" green="1.00" blue="0.35" /></rect>
	</element>
	<element name="led_red" defstate="0">
		<rect state="0"><color red="0.30" green="0.12" blue="0.12" /></rect>
		<rect state="1"><color red="1.00" green="0.22" blue="0.18" /></rect>
	</element>
	<element name="key" defstate="0">
		<rect state="0"><color red="0.96" green="0.91" blue="0.74" /></rect>
		<rect state="1"><color red="0.77" green="0.72" blue="0.56" /></rect>
	</element>

	<element name="t_power"><text string="POWER" align="2"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_ready"><text string="READY" align="2"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_paper"><text string="PAPER" align="2"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_out"><text string="OUT" align="2"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_online"><text string="ON LINE"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_ff"><text string="FF"><color red="0.85" green="0.86" blue="0.88" /></text></element>
	<element name="t_lf"><text string="LF"><color red="0.85" green="0.86" blue="0.88" /></text></element>

	<group name="controls">
		<element ref="panel"><bounds x="0" y="0" width="160" height="560" /></element>

		<element ref="t_power"><bounds x="10" y="30" width="100" height="22" /></element>
		<element ref="led_power"><bounds x="124" y="32" width="8" height="18" /></element>
		<element ref="t_ready"><bounds x="10" y="74" width="100" height="22" /></element>
		<element name="fx80_ready_led" ref="led_green"><bounds x="124" y="76" width="8" height="18" /></element>
		<element ref="t_paper"><bounds x="10" y="118" width="100" height="22" /></element>
		<element ref="t_out"><bounds x="10" y="138" width="78" height="22" /></element>
		<element name="fx80_paper_led" ref="led_red"><bounds x="124" y="120" width="8" height="18" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x01"><bounds x="40" y="190" width="76" height="76" /></element>
		<element name="fx80_online_led" ref="led_green"><bounds x="124" y="194" width="8" height="18" /></element>
		<element ref="t_online"><bounds x="20" y="274" width="120" height="22" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x02"><bounds x="40" y="318" width="76" height="76" /></element>
		<element ref="t_ff"><bounds x="40" y="402" width="76" height="22" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x04"><bounds x="40" y="446" width="76" height="76" /></element>
		<element ref="t_lf"><bounds x="40" y="530" width="76" height="22" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="360" />
		</screen>
		<element ref="case"><bounds x="0" y="360" width="1140" height="240" /></element>
		<element ref="case_dark"><bounds x="0" y="360" width="1140" height="6" /></element>
		<element ref="case"><bounds x="1140" y="0" width="240" height="600" /></element>
		<group ref="controls"><bounds x="1180" y="20" width="160" height="560" /></group>
	</view>

	<view name="Control panel">
		<element ref="case"><bounds x="0" y="0" width="240" height="600" /></element>
		<group ref="controls"><bounds x="40" y="20" width="160" height="560" /></group>
	</view>
</mamelayout>
