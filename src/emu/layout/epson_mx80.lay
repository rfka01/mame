<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Epson MX-80: paper and control panel, after a photo of the printer
(cream case, dark recessed panel at the right: POWER, READY and PAPER OUT lamps
 right of their labels, ON LINE key with its lamp at its right, FF and LF keys,
 labels below the keys; ribbed paper knob at the right side)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.89" green="0.86" blue="0.76" /></rect></element>
	<element name="case_dark"><rect><color red="0.80" green="0.77" blue="0.67" /></rect></element>
	<element name="panel_rim"><rect><color red="0.70" green="0.67" blue="0.58" /></rect></element>
	<element name="panel"><rect><color red="0.31" green="0.30" blue="0.28" /></rect></element>
	<element name="knob">
		<rect><color red="0.12" green="0.12" blue="0.12" /></rect>
		<rect><bounds x="0.00" y="0.10" width="1.0" height="0.04" /><color red="0.30" green="0.30" blue="0.30" /></rect>
		<rect><bounds x="0.00" y="0.30" width="1.0" height="0.04" /><color red="0.30" green="0.30" blue="0.30" /></rect>
		<rect><bounds x="0.00" y="0.50" width="1.0" height="0.04" /><color red="0.30" green="0.30" blue="0.30" /></rect>
		<rect><bounds x="0.00" y="0.70" width="1.0" height="0.04" /><color red="0.30" green="0.30" blue="0.30" /></rect>
		<rect><bounds x="0.00" y="0.90" width="1.0" height="0.04" /><color red="0.30" green="0.30" blue="0.30" /></rect>
	</element>

	<element name="led_power"><rect><color red="0.40" green="0.90" blue="0.30" /></rect></element>
	<element name="led_green" defstate="0">
		<rect state="0"><color red="0.16" green="0.28" blue="0.14" /></rect>
		<rect state="1"><color red="0.40" green="0.90" blue="0.30" /></rect>
	</element>
	<element name="led_red" defstate="0">
		<rect state="0"><color red="0.36" green="0.12" blue="0.12" /></rect>
		<rect state="1"><color red="1.00" green="0.20" blue="0.16" /></rect>
	</element>
	<element name="key" defstate="0">
		<rect state="0"><color red="0.92" green="0.89" blue="0.80" /></rect>
		<rect state="1"><color red="0.72" green="0.69" blue="0.61" /></rect>
	</element>

	<element name="t_power"><text string="POWER" align="2"><color red="0.80" green="0.80" blue="0.80" /></text></element>
	<element name="t_ready"><text string="READY" align="2"><color red="0.80" green="0.80" blue="0.80" /></text></element>
	<element name="t_paper"><text string="PAPER" align="2"><color red="0.80" green="0.80" blue="0.80" /></text></element>
	<element name="t_out"><text string="OUT" align="1"><color red="0.80" green="0.80" blue="0.80" /></text></element>
	<element name="t_online"><text string="ON LINE"><color red="0.80" green="0.80" blue="0.80" /></text></element>
	<element name="t_ff"><text string="F F"><color red="0.80" green="0.80" blue="0.80" /></text></element>
	<element name="t_lf"><text string="L F"><color red="0.80" green="0.80" blue="0.80" /></text></element>

	<group name="controls">
		<element ref="panel_rim"><bounds x="0" y="0" width="200" height="620" /></element>
		<element ref="panel"><bounds x="6" y="6" width="188" height="608" /></element>

		<element ref="t_power"><bounds x="20" y="30" width="120" height="24" /></element>
		<element ref="led_power"><bounds x="154" y="30" width="12" height="22" /></element>
		<element ref="t_ready"><bounds x="20" y="74" width="120" height="24" /></element>
		<element name="mx80_ready_led" ref="led_green"><bounds x="154" y="74" width="12" height="22" /></element>
		<element ref="t_paper"><bounds x="20" y="116" width="120" height="24" /></element>
		<element ref="t_out"><bounds x="70" y="140" width="84" height="24" /></element>
		<element name="mx80_paper_led" ref="led_red"><bounds x="154" y="122" width="12" height="22" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x01"><bounds x="50" y="194" width="84" height="84" /></element>
		<element name="mx80_online_led" ref="led_green"><bounds x="154" y="220" width="12" height="22" /></element>
		<element ref="t_online"><bounds x="30" y="288" width="140" height="24" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x08"><bounds x="50" y="336" width="84" height="84" /></element>
		<element ref="t_ff"><bounds x="50" y="430" width="84" height="24" /></element>

		<element ref="key" inputtag="PANEL" inputmask="0x04"><bounds x="50" y="478" width="84" height="84" /></element>
		<element ref="t_lf"><bounds x="50" y="572" width="84" height="24" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="360" />
		</screen>
		<element ref="case"><bounds x="0" y="360" width="1140" height="300" /></element>
		<element ref="case_dark"><bounds x="0" y="360" width="1140" height="6" /></element>
		<element ref="case"><bounds x="1140" y="0" width="280" height="660" /></element>
		<group ref="controls"><bounds x="1170" y="20" width="200" height="620" /></group>
		<element ref="knob"><bounds x="1384" y="120" width="36" height="150" /></element>
	</view>

	<view name="Control panel">
		<element ref="case"><bounds x="0" y="0" width="260" height="660" /></element>
		<group ref="controls"><bounds x="30" y="20" width="200" height="620" /></group>
	</view>
</mamelayout>
