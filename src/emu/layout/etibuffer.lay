<?xml version="1.0"?>
<!--
license:CC0-1.0
authors:rfka01
ETI Print Buffer 48K: buffer graph, LEDs and switches
-->
<mamelayout version="2">

	<element name="panel"><rect><color red="0.12" green="0.12" blue="0.13" /></rect></element>

	<element name="led_red" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.1" /></disk>
		<disk state="0"><color red="0.3" green="0.06" blue="0.06" /></disk>
	</element>

	<element name="button">
		<rect><color red="0.05" green="0.05" blue="0.05" /></rect>
		<rect state="0"><bounds x="0.12" y="0.12" width="0.76" height="0.76" /><color red="0.8" green="0.8" blue="0.8" /></rect>
		<rect state="1"><bounds x="0.2" y="0.2" width="0.6" height="0.6" /><color red="0.55" green="0.55" blue="0.55" /></rect>
	</element>

	<element name="t_title"><text string="ETI PRINT BUFFER 48K"><color red="0.9" green="0.9" blue="0.9" /></text></element>
	<element name="t_prn"><text string="PRINTER READY" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_buf"><text string="BUFFER READY" align="1"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_test"><text string="TEST"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_clear"><text string="CLEAR"><color red="0.85" green="0.85" blue="0.85" /></text></element>
	<element name="t_graph"><text string="buffer: tail cyan, head green, count hex"><color red="0.6" green="0.6" blue="0.6" /></text></element>

	<view name="ETI Print Buffer">
		<bounds x="0" y="0" width="100" height="120" />
		<element ref="panel"><bounds x="0" y="0" width="100" height="120" /></element>
		<element ref="t_title"><bounds x="4" y="3" width="92" height="7" /></element>

		<screen tag="screen"><bounds x="8" y="14" width="10" height="96" /></screen>

		<element name="eti_printerready_led" ref="led_red"><bounds x="28" y="20" width="5" height="5" /></element>
		<element ref="t_prn"><bounds x="36" y="20" width="58" height="5" /></element>
		<element name="eti_bufferready_led" ref="led_red"><bounds x="28" y="30" width="5" height="5" /></element>
		<element ref="t_buf"><bounds x="36" y="30" width="58" height="5" /></element>

		<element ref="button" inputtag="TEST" inputmask="0x01"><bounds x="34" y="50" width="16" height="16" /></element>
		<element ref="t_test"><bounds x="30" y="68" width="24" height="5" /></element>
		<element ref="button" inputtag="CLEAR" inputmask="0x01"><bounds x="66" y="50" width="16" height="16" /></element>
		<element ref="t_clear"><bounds x="62" y="68" width="24" height="5" /></element>

		<element ref="t_graph"><bounds x="22" y="104" width="76" height="4" /></element>
	</view>
</mamelayout>
