<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
HP DeskJet 540: paper and control panel, after photos of the printer (the right front of the
case holds two round keys one above the other, Resume above and Power below, each
with its lamp at the upper right)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.87" green="0.86" blue="0.81" /></rect></element>
	<element name="case_edge"><rect><color red="0.76" green="0.75" blue="0.70" /></rect></element>
	<element name="badge">
		<rect><color red="0.60" green="0.60" blue="0.58" /></rect>
		<rect><bounds x="0.01" y="0.04" width="0.98" height="0.92" /><color red="0.90" green="0.90" blue="0.87" /></rect>
	</element>
	<element name="t_hp1"><text string="HEWLETT" align="1"><color red="0.20" green="0.20" blue="0.20" /></text></element>
	<element name="t_hp2"><text string="PACKARD" align="1"><color red="0.20" green="0.20" blue="0.20" /></text></element>
	<element name="hp_logo">
		<rect><color red="0.25" green="0.30" blue="0.40" /></rect>
		<text string="hp"><bounds x="0.1" y="0.05" width="0.8" height="0.9" /><color red="0.95" green="0.95" blue="0.95" /></text>
	</element>
	<element name="t_model"><text string="DeskJet 540" align="1"><color red="0.40" green="0.55" blue="0.80" /></text></element>

	<element name="key" defstate="0">
		<disk><color red="0.62" green="0.61" blue="0.57" /></disk>
		<disk state="0"><bounds x="0.08" y="0.08" width="0.84" height="0.84" /><color red="0.90" green="0.89" blue="0.85" /></disk>
		<disk state="1"><bounds x="0.08" y="0.08" width="0.84" height="0.84" /><color red="0.76" green="0.75" blue="0.71" /></disk>
	</element>
	<element name="lamp" defstate="0">
		<disk><color red="0.25" green="0.25" blue="0.24" /></disk>
		<disk state="1"><bounds x="0.1" y="0.1" width="0.8" height="0.8" /><color red="0.40" green="1.00" blue="0.30" /></disk>
	</element>

	<!-- Resume: a sheet with an arrow; Power: a circle broken by a line -->
	<element name="sym_resume">
		<rect><bounds x="0.20" y="0.10" width="0.50" height="0.80" /><color red="0.30" green="0.30" blue="0.30" /></rect>
		<rect><bounds x="0.26" y="0.18" width="0.38" height="0.64" /><color red="0.87" green="0.86" blue="0.81" /></rect>
		<rect><bounds x="0.40" y="0.30" width="0.50" height="0.10" /><color red="0.30" green="0.30" blue="0.30" /></rect>
		<rect><bounds x="0.80" y="0.30" width="0.10" height="0.40" /><color red="0.30" green="0.30" blue="0.30" /></rect>
	</element>
	<element name="sym_power">
		<disk><bounds x="0.10" y="0.15" width="0.80" height="0.80" /><color red="0.30" green="0.30" blue="0.30" /></disk>
		<disk><bounds x="0.20" y="0.25" width="0.60" height="0.60" /><color red="0.87" green="0.86" blue="0.81" /></disk>
		<rect><bounds x="0.38" y="0.00" width="0.24" height="0.30" /><color red="0.87" green="0.86" blue="0.81" /></rect>
		<rect><bounds x="0.45" y="0.00" width="0.10" height="0.50" /><color red="0.30" green="0.30" blue="0.30" /></rect>
	</element>
	<element name="t_resume"><text string="Resume"><color red="0.35" green="0.35" blue="0.35" /></text></element>
	<element name="t_power"><text string="Power"><color red="0.35" green="0.35" blue="0.35" /></text></element>

	<group name="panel">
		<element ref="case"><bounds x="0" y="0" width="200" height="300" /></element>
		<element ref="case_edge"><bounds x="0" y="0" width="4" height="300" /></element>

		<element ref="sym_resume"><bounds x="40" y="58" width="34" height="34" /></element>
		<element ref="key" inputtag="KEYS" inputmask="0x02"><bounds x="90" y="50" width="56" height="56" /></element>
		<element ref="lamp" name="hpdj540_led1"><bounds x="146" y="34" width="14" height="14" /></element>
		<element ref="t_resume"><bounds x="70" y="112" width="96" height="22" /></element>

		<element ref="sym_power"><bounds x="40" y="178" width="34" height="34" /></element>
		<element ref="key" inputtag="KEYS" inputmask="0x01"><bounds x="90" y="170" width="56" height="56" /></element>
		<element ref="lamp" name="hpdj540_led0"><bounds x="146" y="154" width="14" height="14" /></element>
		<element ref="t_power"><bounds x="70" y="232" width="96" height="22" /></element>
	</group>

	<view name="Paper and Control Panel">
		<!-- the paper view is 9 inches wide; a sheet runs from 0.25 inch to 8.75 inch.  The
		     printer front reaches about 20 mm (100 units) past the sheet on both sides -->
		<screen tag="bitmap_printer:screen"><bounds x="0" y="0" width="1140" height="380" /></screen>
		<element ref="case"><bounds x="-68" y="380" width="1276" height="224" /></element>
		<element ref="case_edge"><bounds x="-68" y="380" width="1276" height="4" /></element>
		<element ref="badge"><bounds x="-30" y="410" width="330" height="60" /></element>
		<element ref="hp_logo"><bounds x="-20" y="426" width="34" height="28" /></element>
		<element ref="t_hp1"><bounds x="22" y="422" width="100" height="18" /></element>
		<element ref="t_hp2"><bounds x="22" y="440" width="100" height="18" /></element>
		<element ref="t_model"><bounds x="130" y="418" width="160" height="40" /></element>
		<group ref="panel"><bounds x="1050" y="390" width="136" height="204" /></group>
	</view>

	<view name="Control Panel">
		<element ref="case"><bounds x="0" y="0" width="660" height="300" /></element>
		<element ref="badge"><bounds x="30" y="30" width="330" height="60" /></element>
		<element ref="hp_logo"><bounds x="40" y="46" width="34" height="28" /></element>
		<element ref="t_hp1"><bounds x="82" y="42" width="100" height="18" /></element>
		<element ref="t_hp2"><bounds x="82" y="60" width="100" height="18" /></element>
		<element ref="t_model"><bounds x="190" y="38" width="160" height="40" /></element>
		<group ref="panel"><bounds x="440" y="0" width="200" height="300" /></group>
	</view>
</mamelayout>
