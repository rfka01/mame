<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
HP DeskJet 550C: paper and control panel, after photos of the panel (four columns of
keys, a small key above and a large key below each legend, the LEDs in the legends)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.87" green="0.85" blue="0.78" /></rect></element>
	<element name="case_dark"><rect><color red="0.74" green="0.72" blue="0.65" /></rect></element>
	<element name="bezel"><rect><color red="0.80" green="0.78" blue="0.71" /></rect></element>
	<element name="legend"><rect><color red="0.88" green="0.87" blue="0.84" /></rect></element>
	<element name="legend_dark"><rect><color red="0.80" green="0.80" blue="0.78" /></rect></element>
	<element name="legend_reset"><rect><color red="0.47" green="0.47" blue="0.47" /></rect></element>
	<element name="line"><rect><color red="0.55" green="0.55" blue="0.53" /></rect></element>

	<element name="key_top" defstate="0">
		<rect><color red="0.62" green="0.58" blue="0.48" /></rect>
		<rect state="0"><bounds x="0.02" y="0.08" width="0.96" height="0.84" /><color red="0.84" green="0.76" blue="0.60" /></rect>
		<rect state="1"><bounds x="0.02" y="0.08" width="0.96" height="0.84" /><color red="0.70" green="0.63" blue="0.50" /></rect>
	</element>
	<element name="key_bottom" defstate="0">
		<rect><color red="0.62" green="0.60" blue="0.52" /></rect>
		<rect state="0"><bounds x="0.02" y="0.03" width="0.96" height="0.94" /><color red="0.90" green="0.88" blue="0.78" /></rect>
		<rect state="1"><bounds x="0.02" y="0.03" width="0.96" height="0.94" /><color red="0.76" green="0.74" blue="0.66" /></rect>
		<disk><bounds x="0.33" y="0.15" width="0.34" height="0.70" /><color red="0.80" green="0.78" blue="0.68" /></disk>
	</element>
	<element name="led" defstate="0">
		<rect><color red="0.38" green="0.38" blue="0.37" /></rect>
		<rect state="1"><bounds x="0.06" y="0.12" width="0.88" height="0.76" /><color red="0.40" green="1.00" blue="0.30" /></rect>
	</element>

	<!-- the portrait and landscape page symbols -->
	<element name="page_portrait">
		<rect><bounds x="0.20" y="0.00" width="0.60" height="1.00" /><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect><bounds x="0.26" y="0.05" width="0.48" height="0.90" /><color red="0.95" green="0.95" blue="0.93" /></rect>
		<rect><bounds x="0.32" y="0.18" width="0.36" height="0.06" /><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect><bounds x="0.32" y="0.34" width="0.36" height="0.06" /><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect><bounds x="0.32" y="0.50" width="0.36" height="0.06" /><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect><bounds x="0.32" y="0.66" width="0.36" height="0.06" /><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect><bounds x="0.32" y="0.82" width="0.24" height="0.06" /><color red="0.25" green="0.25" blue="0.25" /></rect>
	</element>
	<element name="page_landscape">
		<rect><bounds x="0.00" y="0.15" width="1.00" height="0.70" /><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect><bounds x="0.04" y="0.21" width="0.92" height="0.58" /><color red="0.95" green="0.95" blue="0.93" /></rect>
		<rect><bounds x="0.12" y="0.32" width="0.76" height="0.06" /><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect><bounds x="0.12" y="0.47" width="0.76" height="0.06" /><color red="0.25" green="0.25" blue="0.25" /></rect>
		<rect><bounds x="0.12" y="0.62" width="0.50" height="0.06" /><color red="0.25" green="0.25" blue="0.25" /></rect>
	</element>
	<element name="dot_y"><disk><color red="1.00" green="0.90" blue="0.10" /></disk></element>
	<element name="dot_m"><disk><color red="0.95" green="0.15" blue="0.55" /></disk></element>
	<element name="dot_c"><disk><color red="0.10" green="0.60" blue="0.95" /></disk></element>
	<element name="dot_k"><disk><color red="0.25" green="0.25" blue="0.25" /></disk></element>

	<element name="t_reset"><text string="Reset" align="1"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="t_clean"><text string="Clean" align="1"><color red="0.45" green="0.45" blue="0.45" /></text></element>
	<element name="t_align1"><text string="Alignment" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_align2"><text string="Test" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_install1"><text string="Install Print" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_install2"><text string="Cartridge" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_load1"><text string="Load/Eject" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_load2"><text string="Paper" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_font"><text string="Font" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_status"><text string="Status" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_quality"><text string="Quality" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_condensed"><text string="Condensed" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_busy"><text string="Busy" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_ready"><text string="Ready" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_draft"><text string="Draft" align="1"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_hp"><text string="HEWLETT PACKARD" align="1"><color red="0.20" green="0.20" blue="0.20" /></text></element>
	<element name="t_model"><text string="DeskJet 550C" align="1"><color red="0.35" green="0.35" blue="0.35" /></text></element>

	<group name="panel">
		<element ref="bezel"><bounds x="0" y="0" width="560" height="340" /></element>

		<!-- small keys -->
		<element ref="key_top" inputtag="KEYS" inputmask="0x80"><bounds x="12" y="10" width="124" height="22" /></element>
		<element ref="key_top" inputtag="KEYS" inputmask="0x20"><bounds x="146" y="10" width="124" height="22" /></element>
		<element ref="key_top" inputtag="KEYS" inputmask="0x08"><bounds x="280" y="10" width="124" height="22" /></element>
		<element ref="key_top" inputtag="KEYS" inputmask="0x02"><bounds x="414" y="10" width="124" height="22" /></element>

		<!-- legends -->
		<element ref="legend"><bounds x="12" y="38" width="526" height="216" /></element>
		<element ref="legend_reset"><bounds x="12" y="38" width="130" height="36" /></element>
		<element ref="legend_dark"><bounds x="146" y="38" width="130" height="36" /></element>
		<element ref="legend_dark"><bounds x="280" y="38" width="130" height="84" /></element>
		<element ref="legend_dark"><bounds x="414" y="38" width="124" height="120" /></element>
		<element ref="line"><bounds x="142" y="38" width="3" height="216" /></element>
		<element ref="line"><bounds x="276" y="38" width="3" height="216" /></element>
		<element ref="line"><bounds x="410" y="38" width="3" height="216" /></element>
		<element ref="line"><bounds x="146" y="74" width="130" height="2" /></element>
		<element ref="line"><bounds x="280" y="122" width="130" height="2" /></element>
		<element ref="line"><bounds x="414" y="158" width="124" height="2" /></element>

		<element ref="t_reset"><bounds x="20" y="42" width="110" height="28" /></element>
		<element ref="t_clean"><bounds x="154" y="42" width="110" height="28" /></element>
		<element ref="t_align1"><bounds x="288" y="42" width="118" height="24" /></element>
		<element ref="t_align2"><bounds x="288" y="64" width="118" height="24" /></element>
		<element ref="t_install1"><bounds x="420" y="42" width="116" height="24" /></element>
		<element ref="t_install2"><bounds x="420" y="64" width="116" height="24" /></element>

		<!-- Font: portrait, landscape, condensed -->
		<element name="hpdj550c_led0" ref="led"><bounds x="158" y="92" width="22" height="11" /></element>
		<element ref="page_portrait"><bounds x="190" y="82" width="28" height="30" /></element>
		<element name="hpdj550c_led1" ref="led"><bounds x="158" y="128" width="22" height="11" /></element>
		<element ref="page_landscape"><bounds x="188" y="118" width="40" height="30" /></element>
		<element name="hpdj550c_led2" ref="led"><bounds x="158" y="164" width="22" height="11" /></element>
		<element ref="t_condensed"><bounds x="184" y="158" width="92" height="22" /></element>

		<!-- Alignment Test, Busy, Ready -->
		<element name="hpdj550c_led3" ref="led"><bounds x="292" y="96" width="22" height="11" /></element>
		<element name="hpdj550c_led8" ref="led"><bounds x="292" y="136" width="22" height="11" /></element>
		<element ref="t_busy"><bounds x="320" y="130" width="80" height="22" /></element>
		<element name="hpdj550c_led4" ref="led"><bounds x="292" y="164" width="22" height="11" /></element>
		<element ref="t_ready"><bounds x="320" y="158" width="80" height="22" /></element>

		<!-- print cartridges, Draft -->
		<element name="hpdj550c_led6" ref="led"><bounds x="426" y="100" width="22" height="11" /></element>
		<element ref="dot_y"><bounds x="456" y="97" width="16" height="16" /></element>
		<element ref="dot_m"><bounds x="478" y="97" width="16" height="16" /></element>
		<element ref="dot_c"><bounds x="500" y="97" width="16" height="16" /></element>
		<element name="hpdj550c_led5" ref="led"><bounds x="426" y="130" width="22" height="11" /></element>
		<element ref="dot_k"><bounds x="456" y="127" width="16" height="16" /></element>
		<element name="hpdj550c_led7" ref="led"><bounds x="426" y="174" width="22" height="11" /></element>
		<element ref="t_draft"><bounds x="454" y="168" width="80" height="22" /></element>

		<element ref="t_load1"><bounds x="20" y="196" width="118" height="26" /></element>
		<element ref="t_load2"><bounds x="20" y="220" width="118" height="26" /></element>
		<element ref="t_font"><bounds x="154" y="220" width="110" height="26" /></element>
		<element ref="t_status"><bounds x="288" y="220" width="110" height="26" /></element>
		<element ref="t_quality"><bounds x="422" y="220" width="110" height="26" /></element>

		<!-- large keys -->
		<element ref="key_bottom" inputtag="KEYS" inputmask="0x40"><bounds x="12" y="262" width="126" height="66" /></element>
		<element ref="key_bottom" inputtag="KEYS" inputmask="0x10"><bounds x="146" y="262" width="126" height="66" /></element>
		<element ref="key_bottom" inputtag="KEYS" inputmask="0x04"><bounds x="280" y="262" width="126" height="66" /></element>
		<element ref="key_bottom" inputtag="KEYS" inputmask="0x01"><bounds x="414" y="262" width="126" height="66" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="380" />
		</screen>
		<element ref="case"><bounds x="0" y="380" width="1140" height="380" /></element>
		<element ref="case_dark"><bounds x="0" y="380" width="1140" height="6" /></element>
		<element ref="t_hp"><bounds x="40" y="410" width="260" height="30" /></element>
		<element ref="t_model"><bounds x="40" y="442" width="260" height="40" /></element>
		<group ref="panel"><bounds x="560" y="400" width="560" height="340" /></group>
	</view>

	<view name="Control Panel">
		<element ref="case"><bounds x="0" y="0" width="600" height="380" /></element>
		<group ref="panel"><bounds x="20" y="20" width="560" height="340" /></group>
	</view>
</mamelayout>
