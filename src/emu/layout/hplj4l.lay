<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
HP LaserJet 4L: paper and control panel
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.89" green="0.88" blue="0.83" /></rect></element>
	<element name="label"><rect><color red="0.84" green="0.85" blue="0.88" /></rect></element>
	<element name="led_green" defstate="0">
		<rect state="0"><color red="0.18" green="0.24" blue="0.18" /></rect>
		<rect state="1"><color red="0.30" green="1.00" blue="0.30" /></rect>
	</element>
	<element name="led_amber" defstate="0">
		<rect state="0"><color red="0.30" green="0.24" blue="0.16" /></rect>
		<rect state="1"><color red="1.00" green="0.66" blue="0.12" /></rect>
	</element>
	<element name="button" defstate="0">
		<rect state="0"><color red="0.55" green="0.55" blue="0.85" /></rect>
		<rect state="1"><color red="0.40" green="0.40" blue="0.70" /></rect>
	</element>
	<element name="t_error"><text string="Error" align="1"><color red="0.30" green="0.30" blue="0.40" /></text></element>
	<element name="t_paper"><text string="Paper" align="1"><color red="0.30" green="0.30" blue="0.40" /></text></element>
	<element name="t_data"><text string="Data" align="1"><color red="0.30" green="0.30" blue="0.40" /></text></element>
	<element name="t_ready"><text string="Ready" align="1"><color red="0.30" green="0.30" blue="0.40" /></text></element>
	<element name="t_model"><text string="HP LaserJet 4L" align="1"><color red="0.30" green="0.30" blue="0.40" /></text></element>

	<group name="panel">
		<element ref="case"><bounds x="0" y="0" width="160" height="260" /></element>
		<element ref="label"><bounds x="56" y="16" width="86" height="160" /></element>
		<element name="hplj4l_error_led" ref="led_amber"><bounds x="30" y="34" width="18" height="8" /></element>
		<element ref="t_error"><bounds x="62" y="28" width="76" height="20" /></element>
		<element name="hplj4l_paper_led" ref="led_amber"><bounds x="30" y="74" width="18" height="8" /></element>
		<element ref="t_paper"><bounds x="62" y="68" width="76" height="20" /></element>
		<element name="hplj4l_data_led" ref="led_green"><bounds x="30" y="114" width="18" height="8" /></element>
		<element ref="t_data"><bounds x="62" y="108" width="76" height="20" /></element>
		<element name="hplj4l_ready_led" ref="led_green"><bounds x="30" y="154" width="18" height="8" /></element>
		<element ref="t_ready"><bounds x="62" y="148" width="76" height="20" /></element>
		<element ref="button" inputtag="BUTTON" inputmask="0x01"><bounds x="26" y="196" width="22" height="48" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="paper"><bounds x="0" y="0" width="637" height="877" /></screen>
		<group ref="panel"><bounds x="650" y="0" width="160" height="260" /></group>
		<element ref="t_model"><bounds x="650" y="270" width="200" height="24" /></element>
	</view>

	<view name="Control Panel">
		<group ref="panel"><bounds x="0" y="0" width="160" height="260" /></group>
	</view>
</mamelayout>
