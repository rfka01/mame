<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Apple ImageWriter II: paper and control panel, after a photo of the printer
(cream panel at the right front: error and pwr lamps left of the on/off key, the select lamp
 and the two print quality lamps left of their keys, labels above the keys)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.91" green="0.89" blue="0.83" /></rect></element>
	<element name="case_dark"><rect><color red="0.80" green="0.78" blue="0.72" /></rect></element>
	<element name="slot"><rect><color red="0.62" green="0.60" blue="0.55" /></rect></element>

	<element name="led_green" defstate="0">
		<rect state="0"><color red="0.55" green="0.57" blue="0.52" /></rect>
		<rect state="1"><color red="0.20" green="0.75" blue="0.30" /></rect>
	</element>
	<element name="led_red" defstate="0">
		<rect state="0"><color red="0.45" green="0.30" blue="0.28" /></rect>
		<rect state="1"><color red="1.00" green="0.20" blue="0.15" /></rect>
	</element>
	<element name="key" defstate="0">
		<rect state="0"><color red="0.96" green="0.94" blue="0.88" /></rect>
		<rect state="1"><color red="0.78" green="0.76" blue="0.70" /></rect>
	</element>

	<element name="t_error"><text string="error"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_pwr"><text string="pwr"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_onoff"><text string="on/off" align="2"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_select"><text string="select" align="2"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_quality"><text string="print quality" align="2"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_lf"><text string="line feed" align="2"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_ff"><text string="form feed" align="2"><color red="0.30" green="0.30" blue="0.30" /></text></element>
	<element name="t_paper"><text string="paper load/eject" align="2"><color red="0.30" green="0.30" blue="0.30" /></text></element>

	<group name="controls">
		<element ref="case"><bounds x="0" y="0" width="200" height="420" /></element>

		<element ref="t_error"><bounds x="8" y="10" width="40" height="16" /></element>
		<element ref="t_pwr"><bounds x="50" y="10" width="34" height="16" /></element>
		<element ref="t_onoff"><bounds x="90" y="14" width="100" height="22" /></element>
		<element name="iw2_error_led" ref="led_red"><bounds x="12" y="30" width="30" height="10" /></element>
		<element name="iw2_power_led" ref="led_green"><bounds x="50" y="30" width="30" height="10" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x10"><bounds x="90" y="40" width="100" height="16" /></element>

		<element ref="t_select"><bounds x="90" y="84" width="100" height="22" /></element>
		<element name="iw2_select_led" ref="led_green"><bounds x="12" y="104" width="68" height="10" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x01"><bounds x="90" y="110" width="100" height="16" /></element>

		<element ref="t_quality"><bounds x="60" y="154" width="130" height="22" /></element>
		<element name="iw2_draft_led" ref="led_green"><bounds x="12" y="168" width="68" height="10" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x08"><bounds x="90" y="180" width="100" height="16" /></element>
		<element name="iw2_quality_led" ref="led_green"><bounds x="12" y="194" width="68" height="10" /></element>

		<element ref="t_lf"><bounds x="90" y="224" width="100" height="22" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x02"><bounds x="90" y="250" width="100" height="16" /></element>

		<element ref="t_ff"><bounds x="90" y="294" width="100" height="22" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x04"><bounds x="90" y="320" width="100" height="16" /></element>
		<element ref="t_paper"><bounds x="40" y="342" width="150" height="20" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="360" />
		</screen>
		<element ref="case"><bounds x="0" y="360" width="1140" height="240" /></element>
		<element ref="case_dark"><bounds x="0" y="360" width="1140" height="6" /></element>
		<element ref="slot"><bounds x="0" y="460" width="1140" height="3" /></element>
		<element ref="case"><bounds x="1140" y="0" width="240" height="600" /></element>
		<group ref="controls"><bounds x="1160" y="170" width="200" height="420" /></group>
	</view>

	<view name="Control panel">
		<group ref="controls"><bounds x="0" y="0" width="200" height="420" /></group>
	</view>
</mamelayout>
