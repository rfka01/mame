Nixdorf MD 16: paper and front panel
-->
<mamelayout version="2">
	<element name="panel"><rect><color red="0.86" green="0.86" blue="0.84" /></rect></element>
	<element name="label"><rect><color red="0.62" green="0.64" blue="0.66" /></rect></element>
	<element name="led_green" defstate="0">
		<disk state="0"><color red="0.10" green="0.25" blue="0.10" /></disk>
		<disk state="1"><color red="0.20" green="1.00" blue="0.20" /></disk>
	</element>
	<element name="led_red" defstate="0">
		<disk state="0"><color red="0.25" green="0.08" blue="0.08" /></disk>
		<disk state="1"><color red="1.00" green="0.20" blue="0.20" /></disk>
	</element>
	<element name="power_on"><disk><color red="0.20" green="1.00" blue="0.20" /></disk></element>
	<element name="key" defstate="0">
		<rect state="0"><color red="0.55" green="0.56" blue="0.58" /></rect>
		<rect state="1"><color red="0.80" green="0.81" blue="0.83" /></rect>
	</element>
	<element name="t_power"><text string="Power" align="1"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_paper"><text string="Paper Empty" align="1"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_online"><text string="On Line" align="1"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_lf"><text string="Line Feed"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_ff"><text string="Form Feed"><color red="0.1" green="0.1" blue="0.1" /></text></element>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="120" />
		</screen>
		<element ref="panel"><bounds x="0" y="120" width="1140" height="100" /></element>
		<element ref="label"><bounds x="300" y="130" width="460" height="80" /></element>

		<element ref="power_on"><bounds x="310" y="140" width="12" height="12" /></element>
		<element ref="t_power"><bounds x="328" y="138" width="90" height="16" /></element>
		<element name="md16_paper_led" ref="led_red"><bounds x="310" y="162" width="12" height="12" /></element>
		<element ref="t_paper"><bounds x="328" y="160" width="110" height="16" /></element>

		<element name="md16_online_led" ref="led_green"><bounds x="460" y="140" width="12" height="12" /></element>
		<element ref="t_online"><bounds x="478" y="138" width="80" height="16" /></element>
		<element ref="key" inputtag="KEYS" inputmask="0x01"><bounds x="460" y="182" width="85" height="20" /></element>

		<element ref="t_lf"><bounds x="560" y="138" width="85" height="16" /></element>
		<element ref="key" inputtag="KEYS" inputmask="0x02"><bounds x="560" y="182" width="85" height="20" /></element>

		<element ref="t_ff"><bounds x="660" y="138" width="85" height="16" /></element>
		<element ref="key" inputtag="KEYS" inputmask="0x04"><bounds x="660" y="182" width="85" height="20" /></element>
	</view>
</mamelayout>
