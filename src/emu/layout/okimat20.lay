<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:rfka01
Okidata Okimate 20: paper and control panel (select key with the ready lamp)
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.86" green="0.85" blue="0.81" /></rect></element>
	<element name="case_dark"><rect><color red="0.74" green="0.73" blue="0.69" /></rect></element>
	<element name="slot"><rect><color red="0.55" green="0.54" blue="0.51" /></rect></element>

	<element name="led_green" defstate="0">
		<rect state="0"><color red="0.50" green="0.53" blue="0.48" /></rect>
		<rect state="1"><color red="0.20" green="0.85" blue="0.30" /></rect>
	</element>
	<element name="key" defstate="0">
		<rect state="0"><color red="0.40" green="0.40" blue="0.42" /></rect>
		<rect state="1"><color red="0.25" green="0.25" blue="0.27" /></rect>
	</element>

	<element name="t_ready"><text string="READY"><color red="0.25" green="0.25" blue="0.25" /></text></element>
	<element name="t_select"><text string="SELECT"><color red="0.25" green="0.25" blue="0.25" /></text></element>
	<element name="t_name"><text string="OKIMATE 20"><color red="0.35" green="0.35" blue="0.35" /></text></element>

	<group name="controls">
		<element ref="case"><bounds x="0" y="0" width="160" height="200" /></element>
		<element ref="t_name"><bounds x="10" y="10" width="140" height="24" /></element>
		<element ref="t_ready"><bounds x="20" y="60" width="120" height="18" /></element>
		<element name="okimate_ready_led" ref="led_green"><bounds x="60" y="84" width="40" height="10" /></element>
		<element ref="t_select"><bounds x="20" y="120" width="120" height="18" /></element>
		<element ref="key" inputtag="PANEL" inputmask="0x01"><bounds x="40" y="144" width="80" height="30" /></element>
	</group>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="2400" height="432" />
		</screen>
		<element ref="case"><bounds x="0" y="432" width="2400" height="300" /></element>
		<element ref="case_dark"><bounds x="0" y="432" width="2400" height="8" /></element>
		<element ref="slot"><bounds x="0" y="560" width="2400" height="4" /></element>
		<element ref="case"><bounds x="2400" y="0" width="400" height="732" /></element>
		<group ref="controls"><bounds x="2440" y="300" width="320" height="400" /></group>
	</view>

	<view name="Control panel">
		<group ref="controls"><bounds x="0" y="0" width="160" height="200" /></group>
	</view>
</mamelayout>
