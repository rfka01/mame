<?xml version="1.0"?>
<!--
license:CC0-1.0
authors:rfka01
Heathkit SK-203 Printer Buffer front panel
-->
<mamelayout version="2">

	<element name="panel"><rect><color red="0.84" green="0.82" blue="0.76" /></rect></element>
	<element name="window"><rect><color red="0.07" green="0.06" blue="0.06" /></rect></element>
	<element name="frame"><rect><color red="0.35" green="0.34" blue="0.31" /></rect></element>
	<element name="framefill"><rect><color red="0.84" green="0.82" blue="0.76" /></rect></element>
	<element name="labelgap"><rect><color red="0.84" green="0.82" blue="0.76" /></rect></element>

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.12" blue="0.1" /></led7seg>
	</element>
	<element name="led" defstate="0">
		<rect state="1"><color red="1.0" green="0.15" blue="0.1" /></rect>
		<rect state="0"><color red="0.3" green="0.06" blue="0.05" /></rect>
	</element>
	<element name="key">
		<rect><color red="0.25" green="0.25" blue="0.24" /></rect>
		<rect state="0"><bounds x="0.08" y="0.1" width="0.84" height="0.8" /><color red="0.72" green="0.71" blue="0.68" /></rect>
		<rect state="1"><bounds x="0.14" y="0.18" width="0.72" height="0.66" /><color red="0.55" green="0.54" blue="0.51" /></rect>
	</element>

	<element name="t_brand"><text string="Heathkit" align="1"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="t_model"><text string="SK-203" align="1"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="t_pb"><text string="PRINTER BUFFER" align="1"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="t_mem"><text string="MEMORY AVAILABLE" align="1"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="t_par"><text string="PARALLEL INPUT"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_ser"><text string="SERIAL INPUT"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_clear"><text string="CLEAR"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_copy"><text string="COPY"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_pprint"><text string="P. PRINT"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_restart"><text string="RESTART"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_offline"><text string="OFFLINE"><color red="0.1" green="0.1" blue="0.1" /></text></element>
	<element name="t_swap"><text string="SWAP"><color red="0.1" green="0.1" blue="0.1" /></text></element>

	<view name="SK-203 Front Panel">
		<bounds x="0" y="0" width="200" height="64" />
		<element ref="panel"><bounds x="0" y="0" width="200" height="64" /></element>

		<!-- display window -->
		<element ref="window"><bounds x="4" y="4" width="58" height="56" /></element>
		<element ref="t_brand"><bounds x="8" y="6" width="24" height="6" /></element>
		<element ref="t_model"><bounds x="33" y="6.5" width="16" height="5" /></element>
		<element ref="t_pb"><bounds x="8" y="12" width="34" height="4" /></element>
		<element name="sk203_digit0" ref="digit"><bounds x="10" y="21" width="13" height="22" /></element>
		<element name="sk203_digit1" ref="digit"><bounds x="26" y="21" width="13" height="22" /></element>
		<element name="sk203_digit2" ref="digit"><bounds x="42" y="21" width="13" height="22" /></element>
		<element ref="t_mem"><bounds x="8" y="50" width="40" height="4.5" /></element>

		<!-- parallel row -->
		<element ref="frame"><bounds x="68" y="7" width="104" height="24" /></element>
		<element ref="framefill"><bounds x="68.5" y="7.5" width="103" height="23" /></element>
		<element ref="labelgap"><bounds x="102" y="5" width="36" height="4.5" /></element>
		<element ref="t_par"><bounds x="103" y="5" width="34" height="4.5" /></element>
		<element ref="t_clear"><bounds x="71" y="10" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL3" inputmask="0x80"><bounds x="72" y="15" width="14" height="11" /></element>
		<element ref="t_copy"><bounds x="91" y="10" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL3" inputmask="0x40"><bounds x="92" y="15" width="14" height="11" /></element>
		<element ref="t_pprint"><bounds x="111" y="10" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL3" inputmask="0x20"><bounds x="112" y="15" width="14" height="11" /></element>
		<element ref="t_restart"><bounds x="131" y="10" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL3" inputmask="0x10"><bounds x="132" y="15" width="14" height="11" /></element>
		<element ref="t_offline"><bounds x="153" y="10" width="17" height="4" /></element>
		<element ref="key" inputtag="KEYCOL1" inputmask="0x80"><bounds x="155" y="15" width="14" height="11" /></element>

		<!-- serial row -->
		<element ref="frame"><bounds x="68" y="34" width="104" height="24" /></element>
		<element ref="framefill"><bounds x="68.5" y="34.5" width="103" height="23" /></element>
		<element ref="labelgap"><bounds x="105" y="32" width="30" height="4.5" /></element>
		<element ref="t_ser"><bounds x="106" y="32" width="28" height="4.5" /></element>
		<element ref="t_clear"><bounds x="71" y="37" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL2" inputmask="0x80"><bounds x="72" y="42" width="14" height="11" /></element>
		<element ref="t_copy"><bounds x="91" y="37" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL2" inputmask="0x40"><bounds x="92" y="42" width="14" height="11" /></element>
		<element ref="t_pprint"><bounds x="111" y="37" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL2" inputmask="0x20"><bounds x="112" y="42" width="14" height="11" /></element>
		<element ref="t_restart"><bounds x="131" y="37" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL2" inputmask="0x10"><bounds x="132" y="42" width="14" height="11" /></element>
		<element ref="t_offline"><bounds x="153" y="37" width="17" height="4" /></element>
		<element ref="key" inputtag="KEYCOL1" inputmask="0x40"><bounds x="155" y="42" width="14" height="11" /></element>

		<!-- swap -->
		<element ref="frame"><bounds x="176" y="18" width="20" height="30" /></element>
		<element ref="framefill"><bounds x="176.5" y="18.5" width="19" height="29" /></element>
		<element name="sk203_swap_led" ref="led"><bounds x="182" y="21" width="8" height="2" /></element>
		<element ref="t_swap"><bounds x="178" y="25" width="16" height="4" /></element>
		<element ref="key" inputtag="KEYCOL0" inputmask="0x80"><bounds x="179" y="31" width="14" height="11" /></element>
	</view>
</mamelayout>
