Star NL-10: paper and front panel
-->
<mamelayout version="2">
	<element name="case"><rect><color red="0.87" green="0.85" blue="0.78" /></rect></element>
	<element name="panel"><rect><color red="0.47" green="0.47" blue="0.48" /></rect></element>

	<element name="key_grey" defstate="0">
		<rect state="0"><color red="0.74" green="0.74" blue="0.75" /></rect>
		<rect state="1"><color red="0.60" green="0.60" blue="0.61" /></rect>
	</element>
	<element name="key_yellow" defstate="0">
		<rect state="0"><color red="0.86" green="0.66" blue="0.16" /></rect>
		<rect state="1"><color red="0.70" green="0.52" blue="0.10" /></rect>
	</element>
	<element name="field_grey"><rect><color red="0.78" green="0.78" blue="0.79" /></rect></element>
	<element name="field_yellow"><rect><color red="0.86" green="0.66" blue="0.16" /></rect></element>
	<element name="divider"><rect><color red="0.12" green="0.12" blue="0.13" /></rect></element>

	<element name="led" defstate="0">
		<rect state="0"><color red="0.30" green="0.45" blue="0.44" /></rect>
		<rect state="1"><color red="0.30" green="1.00" blue="0.45" /></rect>
	</element>
	<element name="led_power"><rect><color red="0.30" green="1.00" blue="0.45" /></rect></element>

	<element name="t_power"><text string="POWER"><color red="0.85" green="0.85" blue="0.86" /></text></element>
	<element name="t_bold"><text string="BOLD"><color red="0.30" green="0.27" blue="0.20" /></text></element>
	<element name="t_mode"><text string="MODE"><color red="0.30" green="0.27" blue="0.20" /></text></element>
	<element name="t_tof"><text string="TOF"><color red="0.40" green="0.40" blue="0.41" /></text></element>
	<element name="t_paper"><text string="PAPER"><color red="0.40" green="0.40" blue="0.41" /></text></element>
	<element name="t_feed"><text string="FEED"><color red="0.40" green="0.40" blue="0.41" /></text></element>
	<element name="t_online"><text string="ON LINE"><color red="0.30" green="0.30" blue="0.31" /></text></element>
	<element name="t_80"><text string="80" align="2"><color red="0.40" green="0.40" blue="0.41" /></text></element>
	<element name="t_draft96"><text string="DRAFT   96" align="2"><color red="0.40" green="0.40" blue="0.41" /></text></element>
	<element name="t_136"><text string="136" align="2"><color red="0.40" green="0.40" blue="0.41" /></text></element>
	<element name="t_nlq"><text string="NLQ        80" align="2"><color red="0.30" green="0.27" blue="0.20" /></text></element>

	<view name="Paper and Control Panel">
		<screen tag="bitmap_printer:screen">
			<bounds x="0" y="0" width="1140" height="360" />
		</screen>
		<element ref="case"><bounds x="0" y="360" width="1140" height="185" /></element>
		<element ref="panel"><bounds x="10" y="374" width="1120" height="157" /></element>

		<!-- POWER -->
		<element ref="led_power"><bounds x="38" y="448" width="18" height="7" /></element>
		<element ref="t_power"><bounds x="62" y="440" width="76" height="22" /></element>

		<!-- BOLD -->
		<element ref="key_yellow" inputtag="PANEL" inputmask="0x04"><bounds x="180" y="390" width="120" height="104" /></element>
		<element name="nl10_bold_led" ref="led"><bounds x="180" y="392" width="28" height="7" /></element>
		<element ref="t_bold"><bounds x="200" y="430" width="80" height="26" /></element>

		<!-- print mode field and LEDs -->
		<element ref="field_grey"><bounds x="313" y="390" width="113" height="84" /></element>
		<element ref="field_yellow"><bounds x="313" y="474" width="113" height="22" /></element>
		<element ref="t_80"><bounds x="318" y="393" width="98" height="18" /></element>
		<element ref="t_draft96"><bounds x="318" y="420" width="98" height="18" /></element>
		<element ref="t_136"><bounds x="318" y="447" width="98" height="18" /></element>
		<element ref="t_nlq"><bounds x="318" y="476" width="98" height="18" /></element>
		<element ref="divider"><bounds x="426" y="390" width="34" height="106" /></element>
		<element name="nl10_mode_led0" ref="led"><bounds x="432" y="398" width="24" height="7" /></element>
		<element name="nl10_mode_led1" ref="led"><bounds x="432" y="425" width="24" height="7" /></element>
		<element name="nl10_mode_led2" ref="led"><bounds x="432" y="452" width="24" height="7" /></element>
		<element name="nl10_mode_led3" ref="led"><bounds x="432" y="482" width="24" height="7" /></element>

		<!-- MODE -->
		<element ref="key_yellow" inputtag="PANEL" inputmask="0x08"><bounds x="466" y="388" width="118" height="105" /></element>
		<element ref="t_mode"><bounds x="485" y="428" width="80" height="26" /></element>

		<!-- TOF, PAPER FEED, ON LINE -->
		<element ref="key_grey" inputtag="PANEL" inputmask="0x20"><bounds x="626" y="384" width="139" height="104" /></element>
		<element ref="t_tof"><bounds x="665" y="424" width="60" height="24" /></element>
		<element ref="key_grey" inputtag="PANEL" inputmask="0x02"><bounds x="806" y="383" width="141" height="105" /></element>
		<element ref="t_paper"><bounds x="836" y="408" width="80" height="24" /></element>
		<element ref="t_feed"><bounds x="841" y="432" width="70" height="24" /></element>
		<element ref="key_grey" inputtag="PANEL" inputmask="0x01"><bounds x="975" y="382" width="140" height="105" /></element>
		<element name="nl10_online_led" ref="led"><bounds x="975" y="384" width="28" height="7" /></element>
		<element ref="t_online"><bounds x="997" y="422" width="96" height="24" /></element>
	</view>
</mamelayout>
