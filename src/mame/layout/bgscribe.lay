<mamelayout version="2">
	<element name="bezel"><rect><color red="0.12" green="0.12" blue="0.12" /></rect></element>

	<view name="Paper and LCD">
		<screen tag="screen"><bounds x="0" y="0" width="2090" height="618" /></screen>
		<element ref="bezel"><bounds x="0" y="618" width="2090" height="196" /></element>
		<!-- LCD is 241 x 18 pixels: keep the pixels square -->
		<screen tag="lcd"><bounds x="20" y="638" width="2050" height="153" /></screen>
	</view>

	<view name="Paper">
		<screen tag="screen"><bounds x="0" y="0" width="2090" height="618" /></screen>
	</view>

	<view name="LCD">
		<screen tag="lcd"><bounds x="0" y="0" width="241" height="18" /></screen>
	</view>
</mamelayout>
