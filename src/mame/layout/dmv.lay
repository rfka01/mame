<!--
	NCR Decision Mate V

	Three cabinet styles:
	  - gray cabinet with two floppy drives
	  - dark front according to the NCR "Corporate Appearance Plan" (CAP)
	  - light cabinet with one floppy drive and an internal hard disk

	The eight test LEDs live on the mainboard at the rear of the machine;
	they are shown below the cabinet so the self-test codes stay visible.
	The K220 diagnostic module display can be enabled as a collection.
-->
<mamelayout version="2">
	<element name="led" defstate="1">
		<disk state="0"><color red="1.0" green="0.15" blue="0.10"/></disk>
		<disk state="1"><color red="0.30" green="0.03" blue="0.02"/></disk>
	</element>
	<element name="l1">
		<text string="1"><color red="0.92" green="0.92" blue="0.85"/></text>
	</element>
	<element name="l2">
		<text string="2"><color red="0.92" green="0.92" blue="0.85"/></text>
	</element>
	<element name="l3">
		<text string="3"><color red="0.92" green="0.92" blue="0.85"/></text>
	</element>
	<element name="l4">
		<text string="4"><color red="0.92" green="0.92" blue="0.85"/></text>
	</element>
	<element name="l5">
		<text string="5"><color red="0.92" green="0.92" blue="0.85"/></text>
	</element>
	<element name="l6">
		<text string="6"><color red="0.92" green="0.92" blue="0.85"/></text>
	</element>
	<element name="l7">
		<text string="7"><color red="0.92" green="0.92" blue="0.85"/></text>
	</element>
	<element name="l8">
		<text string="8"><color red="0.92" green="0.92" blue="0.85"/></text>
	</element>
	<element name="fdd_led" defstate="0">
		<rect state="0"><color red="0.29" green="0.05" blue="0.05" alpha="0.0"/></rect>
		<rect state="1"><color red="1.0" green="0.18" blue="0.12"/></rect>
	</element>
	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.12" blue="0.10"/></led7seg>
	</element>
	<element name="k220">
		<image>
			<data><![CDATA[
<svg xmlns="http://www.w3.org/2000/svg" width="200" height="70" viewBox="0 0 200 70"><rect x="0" y="0" width="200" height="70" rx="4" fill="#1d6b45"/><rect x="0" y="0" width="200" height="70" rx="4" fill="none" stroke="#14492f" stroke-width="3"/><rect x="79" y="3" width="52" height="64" fill="none" stroke="#d8e8dc" stroke-width="1.2" opacity="0.7"/><rect x="82" y="6" width="46" height="58" rx="2" fill="#2b2b2d"/><rect x="82" y="6" width="46" height="58" rx="2" fill="none" stroke="#1a1a1b" stroke-width="2"/><rect x="137" y="3" width="52" height="64" fill="none" stroke="#d8e8dc" stroke-width="1.2" opacity="0.7"/><rect x="140" y="6" width="46" height="58" rx="2" fill="#2b2b2d"/><rect x="140" y="6" width="46" height="58" rx="2" fill="none" stroke="#1a1a1b" stroke-width="2"/><circle cx="12" cy="12" r="5" fill="#c9c9a0"/><circle cx="12" cy="58" r="5" fill="#c9c9a0"/></svg>
			]]></data>
		</image>
	</element>
	<element name="cap_diag">
		<text string="K220"><color red="0.85" green="0.91" blue="0.86"/></text>
	</element>
	<element name="cap_leds">
		<text string="Mainboard test LEDs" align="1"><color red="0.55" green="0.55" blue="0.55"/></text>
	</element>
	<element name="cap_leds2">
		<text string="(rear of the machine)" align="1"><color red="0.45" green="0.45" blue="0.45"/></text>
	</element>
